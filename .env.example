# ============================================================
# BHStore — ENV EXAMPLE
# Скопируй в .env и заполни своими значениями
# ============================================================

# Discord OAuth
DISCORD_CLIENT_ID=your_discord_client_id
DISCORD_CLIENT_SECRET=your_discord_client_secret
DISCORD_REDIRECT_URI=https://bhstore.netlify.app/auth/discord/callback

# JWT (сгенерируй: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))")
JWT_SECRET=change_me_to_a_long_random_string_at_least_64_chars

# Admin
ADMIN_ID=your_discord_id

# Database (Neon)
DATABASE_URL=postgresql://user:password@host/db?sslmode=require

# Telegram Bot
TELEGRAM_BOT_TOKEN=123456:ABC-DEF-your_token_here

# reCAPTCHA
RECAPTCHA_SITE_KEY=your_recaptcha_site_key
RECAPTCHA_SECRET_KEY=your_recaptcha_secret_key

# Public URL
PUBLIC_URL=https://bhstore.netlify.app

# Discord Webhooks
DISCORD_WEBHOOK_CHAT=https://discord.com/api/webhooks/xxx/yyy
DISCORD_WEBHOOK_VERIFY=https://discord.com/api/webhooks/xxx/yyy
DISCORD_WEBHOOK_PURCHASE=https://discord.com/api/webhooks/xxx/yyy
DISCORD_WEBHOOK_REVIEW=https://discord.com/api/webhooks/xxx/yyy
DISCORD_WEBHOOK_WELCOME=https://discord.com/api/webhooks/xxx/yyy
DISCORD_WEBHOOK_NEWS=https://discord.com/api/webhooks/xxx/yyy
DISCORD_WEBHOOK_ADMIN=https://discord.com/api/webhooks/xxx/yyy

# Optional
SKIP_VERIFICATION=false
PORT=3000
HOST=0.0.0.0